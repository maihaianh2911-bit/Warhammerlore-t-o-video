      ],
      "edit": "luot-ngang"
    },
    {
      "start": 63.4,
      "end": 67.4,
      "picture": "icarus",
      "text": "Der beliebteste Sohn starb als Held, doch seine Söhne müssen diesen Tod immer wieder erleben.",
      "credits": [
        "Icarus — 40K Gallery https://40k.gallery/icarus/"
      ],
      "edit": "lui-ra"
    },
    {
      "start": 67.4,
