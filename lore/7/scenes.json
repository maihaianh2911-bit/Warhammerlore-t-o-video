      ],
      "edit": "toan-canh"
    },
    {
      "start": 57.833,
      "end": 60.533,
      "picture": "banner",
      "text": "Wer dem Schwarzen Zorn verfällt, kommt in die Todeskompanie und wird dorthin geschickt, wo der Kampf am härtesten tobt.",
      "credits": [
        "Death Company Flag Bearer — 40K Gallery https://40k.gallery/death-company-flag-bearer/"
      ],
      "edit": "ngang-len"
    },
    {
      "start": 60.533,
