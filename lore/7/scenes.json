{
  "title": "Warum sind die Blood Angels verflucht?",
  "duration": 71.235,
  "scenes": [
    {
      "start": 0.0,
      "end": 3.967,
      "picture": "open",
      "text": "Warum hinterließ ausgerechnet der beliebteste Sohn seinen eigenen Söhnen einen Fluch?",
      "credits": [
        "Sanguinius — adrian4rt, ArtStation"
      ],
      "edit": "ap-mat"
    },
    {
      "start": 3.967,
      "end": 7.467,
      "picture": "primarch",
      "text": "In Warhammer 40.000 ist Sanguinius der Primarch der Blood Angels, der Engel mit den weißen Flügeln, von seinen Brüdern geliebt wie kein anderer.",
      "credits": [
        "Blood Angels 36 — 40K Gallery https://40k.gallery/blood-angels-36/"
      ],
      "edit": "ngang-len"
    },
    {
      "start": 7.467,
      "end": 11.233,
      "picture": "wings",
      "text": "",
      "credits": [
        "Sanguinius — oruam, ArtStation"
      ],
      "edit": "toan-canh"
    },
    {
      "start": 11.233,
      "end": 13.967,
      "picture": "dream",
      "text": "Seit langem sah Sanguinius in Träumen seinen eigenen Tod.",
      "credits": [
        "Come and See — 40K Gallery https://40k.gallery/come-and-see/"
      ],
      "edit": "de-doa"
    },
    {
      "start": 13.967,
      "end": 16.3,
      "picture": "horus",
      "text": "Er wusste, dass er durch die Hand von Horus sterben würde, dem Bruder, den er einst am meisten bewundert hatte.",
      "credits": [
        "Horus Lupercal — adrian4rt, ArtStation"
      ],
      "edit": "va-dap"
    },
    {
      "start": 16.3,
      "end": 19.833,
      "picture": "brothers",
      "text": "Und trotzdem wich er nicht aus.",
      "credits": [
        "Brother Primarchs — 40K Gallery https://40k.gallery/brother-primarchs/"
      ],
      "edit": "toan-canh"
    },
    {
      "start": 19.833,
      "end": 23.167,
      "picture": "teleport",
      "text": "Während der Belagerung von Terra teleportierte sich der Imperator auf Horus' Flaggschiff, die Vengeful Spirit.",
      "credits": [
        "Emperor Teleporting — Richard Bagnall, 40K Gallery https://40k.gallery/emperor-teleporting/"
      ],
      "edit": "lao-toi"
    },
    {
      "start": 23.167,
      "end": 25.533,
      "picture": "ship",
      "text": "",
      "credits": [
        "Vengeful Spirit 2 — 40K Gallery https://40k.gallery/vengeful-spirit-2/"
      ],
      "edit": "luot-ngang"
    },
    {
      "start": 25.533,
      "end": 27.4,
      "picture": "charge",
      "text": "Sanguinius erreichte Horus als Erster.",
      "credits": [
        "Horus Rebellion — 40K Gallery https://40k.gallery/horus-rebellion/"
      ],
      "edit": "lao-toi"
    },
    {
      "start": 27.4,
      "end": 29.667,
      "picture": "offer",
      "text": "Horus bot ihm an, sich dem Chaos anzuschließen.",
