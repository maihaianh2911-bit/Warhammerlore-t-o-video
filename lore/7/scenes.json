      ],
      "edit": "va-dap"
    },
    {
      "start": 38.333,
      "end": 42.133,
      "picture": "thirst",
      "text": "Die Blood Angels trugen schon immer einen Blutdurst in sich, den Roten Durst.",
      "credits": [
        "Blood Angels — alexichim, ArtStation"
      ],
      "edit": "ngang-len"
    },
    {
      "start": 42.133,
      "end": 45.267,
      "picture": "inferno",
      "text": "Doch nach diesem Tod kam etwas Schlimmeres hinzu: der Schwarze Zorn.",
